{
  "manifest_version": 2,
  "name": "e-content · TikTok",
  "version": "0.1.4",
  "description": "Сбор выбранных роликов и комментариев TikTok для локального цеха e-content.",
  "browser_specific_settings": {
    "gecko": { "id": "tiktok-bridge@e-content.local", "strict_min_version": "128.0" }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "https://www.tiktok.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "scripts": ["page-access.js", "background.js"], "persistent": true },
  "browser_action": {
    "default_title": "e-content",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
